# claude-council -- chaves (NUNCA versionar as reais)
# ===================================================
#
# Copie para .claude/council.env (ignorado pelo git), preencha e carregue:
#
#   set -a; source .claude/council.env; set +a
#
# O que JA esta configurado e NAO precisa daqui:
#   .claude/settings.json (versionado)  -- COUNCIL_PROVIDERS, OPENROUTER_MODELS
#                                          e OPENROUTER_MODEL (trava anti-cobranca)
#   ~/.claude/settings.json (global)    -- OPENROUTER_API_KEY, fora de repositorio
#
# Ou seja: os 3 assentos gratis + codex sobem sozinhos. Este arquivo so e
# necessario para o assento opcional do OmniRoute (gateway local do usuario).

# OmniRoute -- provedor proprio (scripts/providers/omniroute.sh), Bearer auth
# de verdade, sem relacao com o "ollama". Ver docs/SKILLS.md, secao "OmniRoute".
export OMNIROUTE_API_KEY=""
export OMNIROUTE_MODEL="BlazesBot-IA"
# export OMNIROUTE_HOST="http://localhost:20128"   # default

# Provedores com degrade automatico para modelo PAGO -- ver docs/SKILLS.md,
# secao "Custo: ZERO". Nao adicione sem tratar isso antes.
# export GEMINI_API_KEY=""
# export OPENAI_API_KEY=""
# export XAI_API_KEY=""
# export PERPLEXITY_API_KEY=""
# export KIMI_API_KEY=""

# Conferir o que esta de pe:
#   bash ~/.claude/plugins/cache/hex-claude-marketplace/claude-council/2026.9.9/scripts/check-status.sh
