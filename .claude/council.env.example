# claude-council -- chaves (NUNCA versionar as reais)
# ===================================================
#
# Copie para .claude/council.env (ignorado pelo git), preencha e carregue:
#
#   set -a; source .claude/council.env; set +a
#
# O que JA esta no .claude/settings.json (bloco "env") e NAO precisa daqui:
#   COUNCIL_PROVIDERS  -- assentos default: openrouter-1..3 + codex
#   OPENROUTER_MODELS  -- glm-5.2, north-mini-code, minimax-m3 (todos :free)
#   OPENROUTER_MODEL   -- trava anti-cobranca do assento "openrouter" sem numero
#
# As chaves ficam fora do settings.json porque settings.json e versionado.

export OPENROUTER_API_KEY=""

# OmniRoute (gateway local) pelo assento "ollama" -- opcional, so depois de
# sourcear este arquivo. A chave vai no userinfo da URL de proposito: veja
# docs/SKILLS.md, secao "OmniRoute".
# export OLLAMA_HOST="http://<sua-chave-omniroute>@localhost:20128"
# export OLLAMA_MODEL="BlazesBot-IA"

# Provedores com degrade automatico para modelo PAGO -- ver docs/SKILLS.md,
# secao "Custo: ZERO". Nao adicione sem tratar isso antes.
# export GEMINI_API_KEY=""
# export OPENAI_API_KEY=""
# export XAI_API_KEY=""
# export PERPLEXITY_API_KEY=""
# export KIMI_API_KEY=""

# Conferir o que esta de pe:
#   bash ~/.claude/plugins/cache/hex-claude-marketplace/claude-council/2026.9.9/scripts/check-status.sh
