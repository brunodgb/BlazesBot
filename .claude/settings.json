{
  "env": {
    "COUNCIL_PROVIDERS": "openrouter-1,openrouter-2,openrouter-3,codex",
    "OPENROUTER_MODELS": "z-ai/glm-5.2:free,cohere/north-mini-code:free,minimax/minimax-m3:free",
    "OPENROUTER_MODEL": "z-ai/glm-5.2:free",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_FLOW_V3_ENABLED": "true",
    "CLAUDE_FLOW_HOOKS_ENABLED": "true"
  },
  "permissions": {
    "allow": [
      "Bash(./.venv/Scripts/python.exe -c ' *)",
      "Bash(./.venv/Scripts/python.exe -m py_compile main.py)",
      "Bash(timeout 6 ./.venv/Scripts/python.exe -c ' *)",
      "Bash(timeout 120 python \"C:/Users/bruno/AppData/Local/Temp/claude/d--Versoes-do-Bot-BlazesBot22---Copia/de9e943e-9afc-43be-bc7a-df64571ca084/scratchpad/sim_app.py\")",
      "Bash(python -c ' *)",
      "Bash(./.venv/Scripts/python.exe -m ruff check blazesbot/web_app.py)",
      "Bash(npx @claude-flow*)",
      "Bash(npx claude-flow*)",
      "Bash(node .claude/*)",
      "mcp__claude-flow__*"
    ],
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/bruno/.local/bin/graphify.EXE hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/bruno/.local/bin/graphify.EXE hook-guard read"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".venv\\Scripts\\python.exe .claude\\hooks\\pre_edit_bloquear_docs_gerados.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".venv\\Scripts\\python.exe .claude\\hooks\\post_edit_web_build.py"
          },
          {
            "type": "command",
            "command": ".venv\\Scripts\\python.exe .claude\\hooks\\post_edit_graphify_update.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".venv\\Scripts\\python.exe .claude\\hooks\\task_observer_hook.py"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "ecc@ecc": true,
    "superpowers@claude-plugins-official": false,
    "codex@openai-codex": false,
    "humanizer@humanizer": false,
    "ruflo-core@ruflo": true,
    "ruflo-swarm@ruflo": false,
    "ruflo-rag-memory@ruflo": false,
    "claude-council@hex-claude-marketplace": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "humanizer": {
      "source": {
        "source": "github",
        "repo": "blader/humanizer"
      }
    },
    "ruflo": {
      "source": {
        "source": "github",
        "repo": "ruvnet/ruflo"
      }
    },
    "hex-claude-marketplace": {
      "source": {
        "source": "github",
        "repo": "hex/claude-marketplace"
      }
    }
  }
}
