{
  "name": "blazesbot-web",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test:web": "agent-browser open http://localhost:5173",
    "test:dist": "agent-browser open ./dist/index.html",
    "test:cdp": "powershell -NoProfile -ExecutionPolicy Bypass -File test-web.ps1 -NoWait",
    "test:cdp:build": "powershell -NoProfile -ExecutionPolicy Bypass -File test-web.ps1 -Build -NoWait",
    "test:cdp:dist": "powershell -NoProfile -ExecutionPolicy Bypass -File test-web.ps1 -Dist -NoWait",
    "test:cdp:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File test-web.ps1 -Stop"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@claude-flow/cli": "^3.38.20",
    "vite": "^8.2.1"
  }
}
